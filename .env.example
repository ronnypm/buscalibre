# Base de datos (Postgres en prod; sqlite si no se define)
DATABASE_URL=sqlite:///./pricetracker.db
# En Postgres:
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/bd

# Credenciales de buscalibre (para importar wishlist / precios)
BUSD_EMAIL=
BUSD_PASSWORD=
BUSD_DOMAIN=https://www.buscalibre.pe

# Telegram: token del bot (@BotFather) y tu chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner
SCAN_INTERVAL_MINUTES=60
ENABLE_SCANNER=1

# IA (OpenCode Zen, API compatible con OpenAI). Opcional: si falta key, usa plantillas.
KILO_API_KEY=
KILO_BASE_URL=https://opencode.ai/zen/v1
KILO_MODEL=nemotron-3-ultra-free